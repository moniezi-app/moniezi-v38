# Public build-time values only. Never place Stripe or Cloudflare secrets here —
# everything in this file is compiled into the app and visible to anyone.

# Deployed Cloudflare license Worker base URL
VITE_LICENSE_API_BASE=https://YOUR-LICENSE-WORKER.workers.dev

# Stripe Checkout/payment link used by the in-app Buy action
VITE_PURCHASE_URL=https://buy.stripe.com/YOUR-CHECKOUT-LINK

# Published customer-facing policy/support values
VITE_TERMS_URL=https://moniezi.com/terms
VITE_PRIVACY_URL=https://moniezi.com/privacy
VITE_SUPPORT_EMAIL=support@moniezi.com
