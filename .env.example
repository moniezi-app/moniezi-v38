# Public build-time values only. Never place Stripe or Cloudflare secrets here —
# everything in this file is compiled into the app and visible to anyone.

# Your Cloudflare licence worker
# Current deployed license backend. Keep this URL unless the Worker itself is redeployed under a new hostname.
VITE_LICENSE_API_BASE=https://moniezi-license-v37.moniezi-vg.workers.dev

# Your Stripe checkout link (the "Buy" button inside the app)
VITE_PURCHASE_URL=https://buy.stripe.com/your-checkout-link

# Published policy pages — required before you take real payments
VITE_TERMS_URL=https://www.example.com/terms
VITE_PRIVACY_URL=https://www.example.com/privacy
VITE_SUPPORT_EMAIL=support@example.com
